# Copy to .env (never commit it). Expo inlines EXPO_PUBLIC_* at build time.
# For EAS builds, set the same names as EAS environment variables instead.

# Purchases: mock | revenuecat  (unset = mock in Expo Go/web, RevenueCat in native builds with a key)
EXPO_PUBLIC_PURCHASES_MODE=mock

# RevenueCat public iOS SDK key (Project settings -> API keys -> App specific key, starts with appl_)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# App Store Connect product ids (defaults shown)
EXPO_PUBLIC_IAP_WEEKLY_ID=clearsky_pro_weekly
EXPO_PUBLIC_IAP_YEARLY_ID=clearsky_pro_yearly

# Build-time config read by app.config.ts
CLEARSKY_BUNDLE_ID=com.gothicscientist.clearsky
EAS_PROJECT_ID=
EXPO_OWNER=

# Test-only (set automatically by tests/e2e/run.mjs; never set for store builds)
# EXPO_PUBLIC_E2E=1
# EXPO_PUBLIC_AWC_BASE=/__awc
